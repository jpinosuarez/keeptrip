

# Firebase Configuration (required even with emulators in local development)
VITE_FIREBASE_API_KEY=your_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Emulator Toggles (default to true for local development; strictly ignored on non-localhost origins)
VITE_USE_FIREBASE_EMULATOR=true
VITE_USE_EMULATORS=true

# E2E Testing Toggle (disabled by default; only active during E2E runs)
VITE_E2E=false

# Mapbox Configuration
VITE_MAPBOX_TOKEN=your_mapbox_token_here

